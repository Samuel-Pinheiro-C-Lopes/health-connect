### Configuration Files ###
# -----------------------------------------------------
# ALLOW application.properties as requested
# -----------------------------------------------------
# We deliberately DO NOT list application.properties here.
# If you previously had a rule ignoring it, use the line below to force-include it:
!src/main/resources/application.properties
!src/main/resources/application.yml

# -----------------------------------------------------
# STILL IGNORE purely secret configs (Recommended)
# -----------------------------------------------------
# It is good practice to ignore profiles meant for local secrets
application-secret.properties
application-secret.yml
application-prod.properties
.env
*.key
*.p12
*.jks
